# Copy to .env.local and adjust. Only EXPO_PUBLIC_* values reach the app, and they are visible to anyone who has the
# bundle, so never put secrets here.

# live talks to the backend; mock serves fictional demo data from inside the app (no backend needed).
EXPO_PUBLIC_API_MODE=live

# Base URL of the backend API. Use http://10.0.2.2:5196 from the Android emulator. Production builds need https.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5196

# dev sends the backend's X-Dev-User header (development builds against a Development backend only).
# oidc signs in with an OpenID Connect provider and sends a bearer token. mock is the offline demo.
EXPO_PUBLIC_AUTH_MODE=dev

# Needed when EXPO_PUBLIC_AUTH_MODE=oidc. The authority is the issuer URL that serves /.well-known/openid-configuration.
# Request the API's scope as well, because the backend validates the audience.
EXPO_PUBLIC_OIDC_AUTHORITY=
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_OIDC_SCOPES=openid profile email offline_access

# Only for EXPO_PUBLIC_API_MODE=mock: happy | empty | rate-limited | credentials-rejected | failing
EXPO_PUBLIC_MOCK_SCENARIO=happy
